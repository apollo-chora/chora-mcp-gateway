# Local configuration for chora-mcp-gateway.
# Copy to .env and fill in values. Never commit .env or secrets.

CHORA_ENV=local
PORT=8080
CHORA_SOURCE_PROJECT=chora-local

# chora-a2a-gateway base URL — the per-tenant MCP partner registry.
MCP_UPSTREAM_A2A_GATEWAY=http://a2a-gateway:8080

# Upstream domain services (tenant-scoped tools fail loud when unset).
MCP_UPSTREAM_DELIVERY=http://delivery:8080
MCP_UPSTREAM_CONSUMPTION=http://consumption:8080
MCP_UPSTREAM_CREATION=http://creation:8080
MCP_UPSTREAM_GOVERNANCE=http://governance:8080

# Local-dev-only API-key seed: key:agid:tenant_id:tool1,tool2
# NEVER set in production — partners come from the chora-a2a-gateway registry.
# MCP_DEV_SEED_API_KEYS=dev-key:01900000-0000-7000-8000-000000000001:01900000-0000-7000-8000-0000000000aa:course_catalog,learning_path_query

# Tracing — OTLP/gRPC endpoint (the OTel Collector). Unset falls back to stdout.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
